CREATE ROLE LOG_DISPATCHER_ROLE;
CREATE ROLE LOG_ANALYST_ROLE;

GRANT SELECT, INSERT, UPDATE ON LOG_ARCHITECT.Shipments TO LOG_DISPATCHER_ROLE;
GRANT SELECT, INSERT ON LOG_ARCHITECT.Shipment_Tracking TO LOG_DISPATCHER_ROLE;
GRANT SELECT ON LOG_ARCHITECT.Customers TO LOG_DISPATCHER_ROLE;

GRANT SELECT ON LOG_ARCHITECT.Shipments TO LOG_ANALYST_ROLE;
GRANT SELECT ON LOG_ARCHITECT.Shipment_Tracking TO LOG_ANALYST_ROLE;
GRANT SELECT ON LOG_ARCHITECT.MV_Shipment_Summary TO LOG_ANALYST_ROLE;

CREATE USER dispatcher_ion IDENTIFIED BY "ion123";
CREATE USER analyst_maria IDENTIFIED BY "maria123";

GRANT LOG_DISPATCHER_ROLE TO dispatcher_ion;
GRANT LOG_ANALYST_ROLE TO analyst_maria;

GRANT CREATE SESSION TO dispatcher_ion;
GRANT CREATE SESSION TO analyst_maria;

